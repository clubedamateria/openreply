# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Opcional: URL JSON com estatisticas do quiz (sessions, funnel, bySource).
# Quando definida, o Funil de conversao mostra os leads vindos do Instagram.
QUIZ_STATS_URL=

# Agendados (posts agendados do Instagram). Todas opcionais: sem elas, a tela
# /agendados continua no ar mas upload/publicacao ficam desligados.
# Pasta no disco da VM onde os arquivos enviados ficam (video_url/image_url da
# Meta tem que ser publicamente acessivel; o Caddy serve essa mesma pasta em
# /media/*, ver deploy/Caddyfile e deploy/docker-compose.prod.yml). Default
# "/data/media" ja funciona no docker-compose.
MEDIA_DIR=/data/media
# Opcional: URL publica da pasta acima, se for diferente de
# "$NEXTAUTH_URL/media" (por exemplo, um CDN na frente do Caddy).
# MEDIA_PUBLIC_BASE_URL=
# Bearer token que o script scripts/agendar-lote.ts usa em POST /api/scheduled-posts.
SCHEDULER_API_TOKEN=
# E-mail de alerta quando um post agendado falha definitivamente (via API do
# Resend, reaproveitando RESEND_API_KEY acima). Sem RESEND_FROM/ALERT_EMAIL_TO,
# a falha so vai para o log.
RESEND_FROM=Agendados <agendados@example.com>
ALERT_EMAIL_TO=voce@example.com

# Fase 4: destinos TikTok/YouTube Shorts dos Agendados, publicados via Zernio
# (https://zernio.com). Opcionais: sem ZERNIO_API_KEY, os dois destinos ficam
# desligados no painel/API/CLI (so o Instagram continua). Com a chave mas sem
# a conta de uma das duas plataformas, so aquele destino fica desligado.
# ZERNIO_API_KEY=
# ID da conta TikTok em Zernio (GET /accounts, campo _id onde platform="tiktok").
# ZERNIO_TIKTOK_ACCOUNT_ID=
# ID da conta YouTube em Zernio (GET /accounts, campo _id onde platform="youtube").
# ZERNIO_YOUTUBE_ACCOUNT_ID=
