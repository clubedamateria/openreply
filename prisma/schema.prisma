// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  zernioConnection  ZernioConnection?
  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  scheduledPosts    ScheduledPost[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  provider          InstagramProvider @default(META)
  zernioAccountId   String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]
  followerSnapshots FollowerSnapshot[]
  scheduledPosts    ScheduledPost[]
  comments          InstagramComment[]

  @@index([workspaceId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled Boolean @default(false)
  dmMessage      String
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  requireFollow           Boolean @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled Boolean @default(false)
  followUpMessage String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes Int @default(0)
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  dmDeliveryUnconfirmed Boolean @default(false)
  publicReplyDeliveryUnconfirmed Boolean @default(false)
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
}

// Legacy reconciliation model; currently unwired. Runtime code does not read
// or write ProcessedComment. Current reconciliation dedup uses owner-reply
// checks and DmLog guards instead.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}


enum InstagramProvider {
  META
  ZERNIO
}

model ZernioConnection {
  workspaceId    String @id
  apiKey         String
  profileId      String?
  webhookId      String?
  webhookSecret  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Claims persist independently of BullMQ retention so old taps never resend.
model PostbackDelivery {
  id String @id
  createdAt DateTime @default(now())
}

/// A post queued to publish to Instagram at a future time, uploaded ahead of
/// time to the VM's local disk (MEDIA_DIR) so the Mac does not need to stay
/// on. Published by the `publish-scheduled` cron in two phases (see
/// ScheduledPostStatus).
model ScheduledPost {
  id                 String                @id @default(cuid())
  workspaceId        String
  /// Fase 4: required for INSTAGRAM, always null for TIKTOK/YOUTUBE (checked
  /// in app code — lib/scheduled-posts/schema.ts — and, where the migration
  /// can express it, by a CHECK constraint; see
  /// prisma/migrations/20260928120000_zernio_platforms). Still doubles as the
  /// "context account" the panel/CLI use to resolve `workspaceId`, even for a
  /// row whose own destination is TikTok/YouTube — see
  /// app/api/scheduled-posts/route.ts.
  instagramAccountId String?
  /// Fase 4: which destination this row publishes to. INSTAGRAM keeps the
  /// original two-phase container flow (prepareDuePosts/publishReadyPosts);
  /// TIKTOK/YOUTUBE go straight from SCHEDULED to PUBLISHING through Zernio
  /// (lib/zernio/client.ts) — see lib/scheduled-posts/engine.ts.
  platform           ScheduledPostPlatform @default(INSTAGRAM)
  mediaType          ScheduledPostMediaType

  /// Order matters for CAROUSEL: it is the slide order. One entry for
  /// REELS/IMAGE.
  mediaUrls    String[]
  /// Storage paths (not public URLs) so the cleanup job can delete the exact
  /// objects 24h after publishing without re-deriving them from the URL.
  storagePaths String[]
  /// REELS only: an optional still frame Instagram uses as the video's cover.
  coverUrl     String?
  /// On-disk filename of coverUrl (MEDIA_DIR), so cleanup can delete it too —
  /// mirrors storagePaths, kept separate because the cover isn't a "slide".
  coverPath    String?

  /// sha256 (hex) of each file in storagePaths, in the same order. Permanent —
  /// never cleared by cleanup, even after the on-disk file is deleted — so the
  /// same content can never be silently rescheduled twice for the same
  /// account (see the dedup check in app/api/scheduled-posts/route.ts).
  contentHash String[] @default([])

  /// Capped at 2,200 chars / 30 hashtags by Instagram; enforced at the API
  /// boundary (zod), not here.
  caption      String
  shareToFeed  Boolean @default(true)
  scheduledFor DateTime

  status ScheduledPostStatus @default(SCHEDULED)

  /// REELS/IMAGE container id. For CAROUSEL, the parent container id (the
  /// slides are in childContainerIds).
  containerId       String?
  childContainerIds String[]
  /// Set only once media_publish succeeds. A non-null mediaId means
  /// media_publish must never be called again for this row.
  mediaId           String? @unique
  /// Reused for Fase 4 (TIKTOK/YOUTUBE): the platform post URL
  /// (`platforms[0].platformPostUrl`, filled in once Zernio resolves it — it
  /// comes back `null` right after publishing) instead of the Instagram
  /// permalink.
  permalink         String?
  /// Fase 4 only. The account this row publishes to on Zernio — resolved
  /// server-side from env (getZernioAccountIdForPlatform), never taken from
  /// client input. Set together with `platform: TIKTOK|YOUTUBE`.
  zernioAccountId   String?
  /// Fase 4 only. The Zernio post id (`post._id` from `POST /posts`),
  /// written the instant the request succeeds — before we even know whether
  /// TikTok/YouTube itself finished publishing — so a later tick never calls
  /// `POST /posts` again for this row (see reconcileZernioPublishing).
  /// `@unique` since present: two rows can never legitimately share one.
  zernioPostId      String? @unique
  /// Fase 4 only: `{ privacyLevel, allowComment, allowDuet, allowStitch,
  /// consentGiven }` for TIKTOK, `{ title, visibility, madeForKids }` for
  /// YOUTUBE — see lib/scheduled-posts/schema.ts for the zod shapes this is
  /// validated against on write and parsed with on read.
  platformSettings Json?

  attempts     Int       @default(0)
  errorMessage String?
  publishedAt  DateTime?
  /// Set on a FAILED row when the engine genuinely could not confirm whether
  /// Meta had already published it before giving up (a media_publish call
  /// whose response was lost, or a container stuck PUBLISHING through a
  /// prolonged Meta outage) — see reconcilePublishedContainer in
  /// lib/scheduled-posts/engine.ts. Retry/reschedule
  /// (app/api/scheduled-posts/[id]/route.ts) refuses to blindly recreate the
  /// container for a row with this set unless the caller confirms the old
  /// container really wasn't published (or passes `force`).
  outcomeUncertain Boolean @default(false)

  /// Who created it: the panel form, or the `agendar-lote` CLI.
  source ScheduledPostSource @default(PAINEL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([workspaceId])
  @@index([contentHash], type: Gin)
  @@index([platform, zernioAccountId])
}

enum ScheduledPostMediaType {
  REELS
  IMAGE
  CAROUSEL
}

/// Fase 4: publish destination. INSTAGRAM via the Meta Graph API (unchanged
/// two-phase flow); TIKTOK/YOUTUBE (YouTube Shorts) via Zernio.
enum ScheduledPostPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum ScheduledPostStatus {
  SCHEDULED
  PREPARING
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

enum ScheduledPostSource {
  PAINEL
  LOTE
}

// One row per Instagram comment, kept for stats (most-commented words/emojis,
// campaign keyword performance, recent-comments feed) independently of the
// DM/campaign pipeline. Fed by the real-time comment webhook and by the daily
// `/api/cron/sync-comments` backfill over each META account's last 30 posts.
// The account's own comments (public replies posted by the automation) are
// filtered out before this table is ever written to, at both ingestion
// points — so every row here is genuinely audience-authored.
model InstagramComment {
  id                 String   @id @default(cuid())
  commentId          String   @unique
  instagramAccountId String
  mediaId            String
  text               String
  username           String?
  commentedAt        DateTime
  parentId           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId, commentedAt])
  @@index([mediaId])
}
